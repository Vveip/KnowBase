# 依赖
node_modules/

# VitePress 构建产物（由 Cloudflare Pages 构建，不要提交）
.vitepress/dist/
.vitepress/cache/

# 刷题题库（由 scripts/gen-quiz.mjs 生成，不提交）
.vitepress/quiz-data.json

# 课件原始 PDF（体积大，不入库；提取出的文本 cail/txt/ 入库）
cail/*.pdf

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/

# 调试产物（开发过程临时文件，不入库）
dev.log
dom1.html
dom2.html
err*.txt
scripts/_*.mjs
