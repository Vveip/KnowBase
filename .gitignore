# 依赖
node_modules/

# VitePress 构建产物（由 Cloudflare Pages 构建，不要提交）
.vitepress/dist/
.vitepress/cache/

# 刷题题库（由 scripts/gen-quiz.mjs 生成，不提交）
.vitepress/quiz-data.json

# 课件原始 PDF（体积大，不入库；提取出的文本 cail/txt/ 入库）
cail/*.pdf
source/*

# 系统文件
.DS_Store
Thumbs.db
dist-bak.7z

# 编辑器
.vscode/
.idea/

# 调试产物（开发过程临时文件，不入库）
dev.log
dom1.html
dom2.html
err*.txt
scripts/_*.mjs

# AI 工作流本地文件（断点续跑笔记 / 本地工具设置，与站点运行无关）
TASKS.md
TASKS-*.md
.claude/

# 资料审计中间产物与本地审计脚本（处理 source/ 私有资料用，站点运行不需要）
audits/
scripts/audit-source.py

# Python 缓存
__pycache__/
scripts/__pycache__/

# 已作废的旧 PDF 转换脚本（文件内有作废说明，保留本地备查，不入库）
scripts/pdf2txt.cjs
scripts/pdf2txt.ps1
