  "cards": [
    {
      "dot": "cyan",
      "title": "透明故障转移",
      "items": [
        "客户端只使用虚拟模型；每次尝试替换 base_url、api_key 与真实 model",
        "上游错误、200 假成功、空流与卡流在字节释放前触发 retry / next / freeze / passthrough"
      ]
    },
    {
      "dot": "emerald",
      "title": "资源与状态边界",
      "items": [
        "全局请求并发、候选并发与 httpx 连接池均有上限",
        "RuntimeState 保存内存健康画像；SQLite 通过有界后台队列写入历史和可选冻结状态"
      ]
    },
    {
      "dot": "rose",
      "title": "控制面与安全",
      "items": [
        "配置写回遵循读盘 → 修改 → 完整校验 → 替换内存 → 备份并原子写盘",
        "默认回环绑定；非回环部署必须由外层鉴权，客户端可配置 server.client_token"
      ]
    }
  ]
